{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "sidecar",
  "description": "Allow spawning bundled sidecars",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "seadio-server", "sidecar": true, "args": true },
        { "name": "netease-api", "sidecar": true, "args": true }
      ]
    }
  ]
}
