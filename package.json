{
  "name": "seadio-app",
  "version": "1.0.0",
  "description": "Local AI DJ Radio powered by Claude",
  "main": "server.js",
  "scripts": {
    "start": "node scripts/start.js",
    "start:server": "node server.js",
    "netease:check": "node scripts/netease-status.js",
    "netease:login": "node scripts/netease-login.js",
    "pkg:server": "pkg --config pkg-server.config.json --output bin/seadio-server-aarch64-apple-darwin server.js",
    "pkg:netease": "pkg --config pkg-netease.config.json --output bin/netease-api-aarch64-apple-darwin vendor/netease-api/app.js",
    "pkg:all": "yarn pkg:server && yarn pkg:netease",
    "tauri:dev": "cd src-tauri && cargo tauri dev",
    "tauri:build": "cd src-tauri && cargo tauri build",
    "test": "node tests/paths.test.js && node tests/server-base.test.js",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d && docker compose logs -f",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "NeteaseCloudMusicApi": "^4.32.0",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-cron": "^3.0.3",
    "openai": "^6.9.1",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.20.0"
  }
}
